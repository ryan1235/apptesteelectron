# ==========================================
# Configurações do Servidor de Salas Ao Vivo (Live Rooms)
# ==========================================

# URL base da API REST
VITE_API_URL=https://archpixel.squareweb.app

# URL do WebSocket de Salas Ao Vivo (WSS para HTTPS/SSL)
VITE_WS_URL=wss://archpixel.squareweb.app/ws/live-room

# Token JWT padrão para autenticação (Bearer Token)
VITE_JWT_TOKEN=sasdadaddad

# Nome e Avatar padrão do Usuário Local
VITE_DEFAULT_USER_NAME=Ryan
VITE_DEFAULT_AVATAR_URL=

# ==========================================
# Configurações de Áudio e Prevenção de Loopback/Eco
# ==========================================
# Previne que o som de quem está na call seja capturado e duplicado durante compartilhamento de tela
VITE_AUDIO_ECHO_CANCELLATION=true
VITE_AUDIO_NOISE_SUPPRESSION=true
VITE_AUDIO_AUTO_GAIN_CONTROL=true
VITE_SCREEN_AUDIO_LOOPBACK_PREVENTION=true
