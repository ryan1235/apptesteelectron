{
  "name": "discord-live-rooms",
  "version": "1.0.0",
  "description": "Discord-style Voice Chat and GPU Screen Sharing Electron App with 50-byte Binary Protocol",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('dist-electron/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\" && node -e \"require('fs').copyFileSync('native/ProcessAudioCapture.exe', 'dist-electron/ProcessAudioCapture.exe')\"",
    "electron:dev": "node scripts/dev.js",
    "electron:build": "npm run build && electron-builder --win",
    "start": "node scripts/dev.js",
    "test:protocol": "tsx src/tests/binaryProtocol.test.ts"
  },
  "build": {
    "appId": "com.archpixel.discordliverooms",
    "productName": "Discord Live Rooms",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "native/ProcessAudioCapture.exe",
        "to": "ProcessAudioCapture.exe"
      }
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discord Live Rooms"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  }
}
